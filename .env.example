# eChat example environment file
# Copy this file to .env and fill in non-secret local values only.

APP_ENV=development
LOG_LEVEL=info
SERVER_BASE_URL=https://api.example.com
WS_BASE_URL=wss://api.example.com
RELAY_URL=https://relay.example.com
POSTGRES_URL=postgresql://user:password@localhost:5432/echat
REDIS_URL=redis://localhost:6379

# These values are placeholders and must never contain production secrets.
# Never commit a real .env file with production credentials.
